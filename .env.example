# Exchange API credentials
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here

# Exchange (binance, bybit, okx)
EXCHANGE_ID=bybit

# Trading parameters
# SYMBOL=BTC/USDT                  # Single symbol (overrides SYMBOLS)
SYMBOLS=all                         # Preset: all, crypto, top10, top20, top50, stocks, metals
                                     # Or comma-separated: BTC/USDT,ETH/USDT,SOL/USDT
                                     # Or mix: top10,stocks,metals
TIMEFRAME=15m
DEPOSIT=150
RISK_PER_TRADE_PCT=2
MAX_LEVERAGE=10
